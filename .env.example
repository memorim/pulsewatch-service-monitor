# Optional local API port; default used by pnpm start.
PORT=4400
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=60
MONITOR_RETENTION_DAYS=30
MONITOR_ALLOWED_HOSTS=memorim.github.io,memorim-flowboard-live.amusedcorgi34.chatgpt.site

# Optional fixed authenticated reverse-proxy origin.
# APP_PUBLIC_ORIGIN=https://operator.example
# Optional incident receiver; HTTPS only, no query/fragment/userinfo. Disabled when empty.
MONITOR_WEBHOOK_URL=
# Persistent mount point, including incidents and the notification outbox.
# PULSEWATCH_DATA_DIRECTORY=/var/lib/pulsewatch
# HOST=0.0.0.0 requires APP_PUBLIC_ORIGIN and APP_OPERATOR_TOKEN.
MONITOR_WEBHOOK_TOKEN=

# Exact source SHA set by the release process; omitted reports local-unversioned.
# APP_REVISION=

# Public operator access requires HTTPS reverse proxy
# APP_PUBLIC_ORIGIN=https://monitor.example.com
# APP_OPERATOR_TOKEN=generate-a-random-secret-of-at-least-32-characters

# Free push alternative to the configured webhook; use a random secret topic.
# NTFY_TOPIC=

# Free persistent database (separate project); keep verified TLS.
# DATABASE_URL=postgresql://owner:password@your-neon-host/pulsewatch?sslmode=verify-full
# For Neon Free scheduled operation set MONITOR_ENABLED=false.
# PostgreSQL defaults both continuous loops to off when unset.
# MONITOR_NOTIFICATIONS_ENABLED=false
