# Optional local API port; default used by pnpm start.
PORT=4400
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=60
MONITOR_RETENTION_DAYS=30
MONITOR_ALLOWED_HOSTS=memorim.github.io,memorim-flowboard-live.amusedcorgi34.chatgpt.site

# Optional fixed authenticated reverse-proxy origin.
# APP_PUBLIC_ORIGIN=https://operator.example
# Optional incident receiver; HTTPS only, no query/fragment/userinfo. Disabled when empty.
MONITOR_WEBHOOK_URL=
MONITOR_WEBHOOK_TOKEN=
